          {
            "q": "avg:aspnet.requests.current{host:$host.value}",
            "display_type": "line",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ],
        "yaxis": {
          "scale": "linear",
          "include_zero": true
        },
