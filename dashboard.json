{
  "title": "CyberArk-Powershell \u2014 IIS & ASP.NET Custom Metrics",
  "description": "All 13 custom metrics from CyberArk-Powershell via DogStatsD",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "host",
      "prefix": "host",
      "default": "CyberArk-Powershell"
    }
  ],
  "widgets": [
